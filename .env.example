# VeloRAG 生产与本地 Docker 部署环境变量示例
# 使用前请复制为 .env 并替换全部占位密码与密钥：cp .env.example .env

VELORAG_ENV=production
VELORAG_SECRET_KEY=replace-with-at-least-32-random-hex-characters
VELORAG_JWT_ALGORITHM=HS256
VELORAG_TOKEN_EXPIRE=60
VELORAG_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VELORAG_MAX_UPLOAD_MB=10

POSTGRES_USER=velorag
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=velorag

# 可选：启用外部 LLM 生成与 OpenAI 向量化
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com/v1
# VELORAG_LLM_MODEL=gpt-4o-mini
